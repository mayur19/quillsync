# quillsync local configuration. ./run.sh copies this file to .env and fills in secrets.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4104
WEB_PORT=5104
APP_ORIGIN=http://localhost:5104
# Local PostgreSQL over the Unix socket in /tmp as the current OS user (no password).
DATABASE_URL=postgres:///quillsync_dev?host=/tmp
TEST_DATABASE_URL=postgres:///quillsync_test?host=/tmp
SESSION_SECRET=replace-me-with-a-long-random-local-only-value
SESSION_TTL_HOURS=168
LOG_LEVEL=info
# Failed sign-ins per email before progressive lockout (30 s doubling to 15 min).
LOGIN_EMAIL_FREE_ATTEMPTS=5
# Sign-in attempts per client IP per 15 minutes; registrations per IP per hour.
LOGIN_IP_RATE_LIMIT_MAX=30
REGISTER_IP_RATE_LIMIT_MAX=5
# Reverse-proxy trust: false (default), a hop count like 1, or proxy IPs/CIDRs (comma-separated).
TRUST_PROXY=false
WS_MAX_MESSAGE_BYTES=262144
DB_POOL_MAX=10
